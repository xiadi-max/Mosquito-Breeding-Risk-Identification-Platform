# YOLOv13 runtime profile. Loaded into the process by start_profile.ps1.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DETECTOR_PROVIDER=yolov13
