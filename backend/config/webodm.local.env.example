# Copy this file to webodm.local.env and fill in the real credentials.
# webodm.local.env is ignored by version control.
WEBODM_URL=http://47.106.179.97:8000
WEBODM_USERNAME=
WEBODM_PASSWORD=
WEBODM_VERIFY_SSL=true
WEBODM_POLL_SECONDS=10
WEBODM_REQUEST_TIMEOUT_SECONDS=3600
# Unit: centimeters per pixel. OpenDroneMap's default is 5.
WEBODM_ORTHOPHOTO_RESOLUTION=5
WEBODM_JPEG_MAX_SIDE=12000
WEBODM_JPEG_QUALITY=90
