APP_ENV=development
APP_COMMIT=
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/mosquito_mapper.sqlite3
STORAGE_ROOT=./data/artifacts
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_UPLOAD_FILES=50
MAX_UPLOAD_FILE_BYTES=52428800
MAX_TASK_BYTES=10737418240
MAX_IMAGE_PIXELS=100000000
JOB_POLL_INTERVAL=1.0
JOB_LEASE_SECONDS=60
JOB_MAX_RETRIES=3
MOSAIC_JOB_TIMEOUT_SECONDS=14400
SSE_HEARTBEAT_SECONDS=15
MOSAIC_PROVIDER=opencv
MOSAIC_WORK_SCALE=0.6
MOSAIC_PANO_CONFIDENCE_THRESHOLD=0.3
MOSAIC_BLACK_BORDER_THRESHOLD=2
MOSAIC_OUTPUT_JPEG_QUALITY=95
# Supported values: fake, yolov13, yolo11
DETECTOR_PROVIDER=fake
MODEL_WEIGHTS_PATH=
MODEL_DEVICE=cpu
MODEL_INPUT_SIZE=640
MODEL_REQUIRED_ULTRALYTICS_VERSION=
INFER_MIN_CONFIDENCE=0.20
REVIEW_THRESHOLD=0.50
AUTO_ACCEPT_THRESHOLD=0.80
NMS_IOU=0.45
DECISION_PROVIDER=rules
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
RISK_MEDIUM_THRESHOLD=40
RISK_HIGH_THRESHOLD=75
BACKUP_ROOT=./backups
BACKUP_RETENTION_DAYS=14
